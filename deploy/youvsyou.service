[Unit]
Description=YOU vs YOU Telegram Mini App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/youvsyou
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/youvsyou/.env
ExecStart=/opt/youvsyou/.venv/bin/python /opt/youvsyou/main.py
KillMode=process
TimeoutStopSec=30
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
