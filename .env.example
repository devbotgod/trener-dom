# Скопируйте в .env и заполните своими значениями.
# Файл .env в git не коммитится.

BOT_TOKEN=123456:REPLACE_ME_WITH_BOTFATHER_TOKEN
BOT_USERNAME=YourBotUsername
WEBAPP_URL=https://your-domain.example/
OWNER_TELEGRAM_ID=0
VIP_USER_IDS=
TIMEZONE=Europe/Moscow
DATABASE_URL=sqlite+aiosqlite:///data/youvsyou.db

# Локальная отладка Mini App без Telegram (только на своей машине):
# ALLOW_DEV_AUTH=1
# YVY_DEV_SECRET=change-me
